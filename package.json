{
  "name": "sigap-wa-command-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp Bot Listener & Dashboard Monitoring Timemark, Sprin, dan Link Anggota",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "tsx server/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/api-smoke.mjs",
    "wa:check": "node scripts/test-wa-connect.mjs",
    "e2e:turjawali": "node scripts/e2e-turjawali.mjs",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "ocr:reocr": "tsx scripts/reocr-timemark.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "baileys": "7.0.0-rc14",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "docx": "9.15.0",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "0.468.0",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "node-cron": "4.6.0",
    "p-queue": "10.0.0",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "6.30.1",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "6.0.1",
    "whatsapp-web.js": "1.34.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "24.7.2",
    "@types/pdfkit": "0.17.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.1",
    "postcss": "8.5.6",
    "prisma": "6.19.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
