# ── Database ──────────────────────────────────────────────────────────────
# SQLite relatif terhadap folder prisma/. Untuk Docker gunakan file:/data/app.db
DATABASE_URL="file:../data/app.db"

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_BASE_URL="http://localhost:5173"
STORAGE_DIR="./storage"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:5173"
TZ="Asia/Jakarta"

# ── WhatsApp ──────────────────────────────────────────────────────────────
# mock = simulator bawaan (aman untuk demo) | webjs = WhatsApp Web via QR
WA_DRIVER="mock"
WA_SESSION_PATH="./data/wa-session"
# Di Docker: /usr/bin/chromium. Kosongkan agar Puppeteer memakai Chrome bawaan.
PUPPETEER_EXECUTABLE_PATH=""
# Pin versi WhatsApp Web. Kosongkan = otomatis (selalu versi terbaru).
# Isi bila muncul error "Failed to download WhatsApp media" / daftar grup kosong
# setelah WhatsApp Web memperbarui diri, mis.:
# WA_WEB_VERSION="2.3000.1047399436-alpha"
WA_WEB_VERSION=""

# ── Upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
