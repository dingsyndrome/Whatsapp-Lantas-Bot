# ── Database ──────────────────────────────────────────────────────────────
# SQLite relatif terhadap folder prisma/. Untuk Docker gunakan file:/data/app.db
DATABASE_URL="file:../data/app.db"

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_BASE_URL="http://localhost:5173"
STORAGE_DIR="./storage"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:5173"
TZ="Asia/Jakarta"

# ── WhatsApp ──────────────────────────────────────────────────────────────
# mock = simulator bawaan (aman untuk demo) | webjs = WhatsApp Web via QR
WA_DRIVER="mock"
WA_SESSION_PATH="./data/wa-session"
# Di Docker: /usr/bin/chromium. Kosongkan agar Puppeteer memakai Chrome bawaan.
PUPPETEER_EXECUTABLE_PATH=""

# ── Upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
